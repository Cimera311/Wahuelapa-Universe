class CloudConflict extends Error {constructor(){super('Ein anderes Gerät hat einen neueren Spielstand gespeichert. Exportiere bei Bedarf deinen lokalen Stand und lade dann den Cloud-Stand.');this.name='CloudConflict';}}
// Client injected for tests. Saves use a database-side atomic revision check.
function createCloud(client,redirectUrl,commandFunction='game-command'){
 let user=null,revision=0,loaded=false,busy=false,authoritative=false,pvp=null,receivedAt=0,pending=null;
 async function perform(request){const result=await client.functions.invoke(commandFunction,{body:request});if(result.error){let message=result.error.message;try{message=(await result.error.context?.json())?.error||message;}catch{}const failure=Error(message||'Spielserver nicht erreichbar.');failure.definitive=result.error.context?.status>=400&&result.error.context?.status<500;throw failure;}if(result.data?.error){const failure=Error(result.data.error);failure.definitive=true;throw failure;}const next=Number(result.data?.revision);if(!Number.isSafeInteger(next)||next<0||!result.data?.pvp)throw Error('Ungültige Serverantwort.');const state=result.data.state?validateSave(result.data.state):null;revision=next;pvp=result.data.pvp;receivedAt=Date.now();return {state,pvp};}
 const checked=result=>{if(result.error)throw result.error;return result.data;};
 return {
  get authoritative(){return authoritative;},get pvp(){return pvp;},get pending(){return pending;},get now(){return pvp?Math.max(pvp.serverNow,pvp.serverNow+Date.now()-receivedAt):Date.now();},get user(){return user;},get revision(){return revision;},get loaded(){return loaded;},
  async session(){const data=checked(await client.auth.getSession());user=data.session?.user||null;loaded=false;return user;},
  async signIn(email,password){if(busy)throw Error('Speicherung läuft noch.');const data=checked(await client.auth.signInWithPassword({email,password}));user=data.user;loaded=false;return user;},
  async signUp(email,password){return checked(await client.auth.signUp({email,password,options:{emailRedirectTo:redirectUrl}}));},
  async gameRequest(request={type:'sync'}){if(!user||!loaded||!authoritative)throw Error('Server-Spielstand zuerst laden.');if(busy)throw Error('Serverabgleich läuft noch.');const mutating=request.type!=='sync';if(mutating){const same=pending&&JSON.stringify({...pending,requestId:undefined})===JSON.stringify({...request,requestId:undefined});if(pending&&!same)throw Error('Bitte zuerst den offenen Auftrag in den Einstellungen erneut prüfen.');request=same?pending:{...request,requestId:crypto.randomUUID()};pending=request;}busy=true;try{const result=await perform(request);if(mutating)pending=null;return result;}catch(e){if(e.definitive){pending=null;throw e;}if(mutating){try{const result=await perform(request);pending=null;return result;}catch(retryError){if(retryError.definitive){pending=null;throw retryError;}}}throw e;}finally{busy=false;}},
  async createGame(name){if(!user||!loaded||!authoritative||revision!==0)throw Error('Neues Server-Spiel kann hier nicht erstellt werden.');return this.gameRequest({type:'new',name});},
  async signOut(){if(busy)throw Error('Speicherung läuft noch.');checked(await client.auth.signOut());user=null;revision=0;loaded=false;authoritative=false;pvp=null;pending=null;},
  async warTimes(){if(!user)throw Error('Bitte anmelden.');const r=await client.rpc('imperium_war_times');if(r.error){if(['PGRST202','42883','42P01'].includes(r.error.code))throw Error('Kriegsarchiv benötigt noch supabase/war-times.sql.');throw r.error;}if(!Array.isArray(r.data)||r.data.length>100)throw Error('Ungültige Archivantwort.');return r.data;},
  async leaderboard(){if(!user)throw Error('Bitte anmelden, um die gemeinsame Rangliste zu sehen.');const result=await client.rpc('imperium_leaderboard');if(result.error){if(result.error.code==='PGRST202'||result.error.code==='42883')throw Error('Die Rangliste benötigt noch die einmalige Supabase-Erweiterung (supabase/leaderboard.sql).');throw result.error;}if(!Array.isArray(result.data))throw Error('Ungültige Ranglisten-Antwort.');return result.data;},
  async reports(filters={}){const r=await client.rpc('imperium_reports',{p_archived:filters.archived===null?null:!!filters.archived,p_kind:filters.kind||null,p_outcome:filters.outcome||null,p_search:filters.search||'',p_since:filters.since||null,p_offset:filters.offset||0,p_mission:filters.mission||null});if(r.error)throw r.error;if(!Array.isArray(r.data?.items)||!Number.isSafeInteger(r.data.total)||r.data.items.length>50)throw Error('Ungültige Berichtsantwort.');return r.data;},
  async community(kind,{op='list',id=null,title='',body='',before=null,request=null,vote=null,status=null}={}){
   if(!user)throw Error('Bitte anmelden, um die Community zu nutzen.');
   const r=await client.rpc('imperium_community',{p_kind:kind,p_op:op,p_id:id,p_title:title,p_body:body,p_before:before,p_request:request,p_vote:vote,p_status:status});
   if(r.error){const messages={RATE_LIMIT:'Bitte warte kurz: Nachrichten alle 5 Sekunden, Wünsche einmal pro Minute.',FORBIDDEN:'Diese Aktion ist nur für den Autor oder Admins verfügbar.',GAME_REQUIRED:'Erstelle zuerst deinen Commander.',AUTH_REQUIRED:'Bitte melde dich erneut an.',INVALID_CONTENT:'Bitte prüfe die Länge deines Beitrags.',POST_NOT_FOUND:'Dieser Beitrag ist nicht mehr verfügbar.'};if(['PGRST202','42883','42P01'].includes(r.error.code))throw Error('Die Community wird noch eingerichtet. Bitte versuche es später erneut.');throw Error(messages[r.error.message]||'Die Community ist gerade nicht erreichbar. Dein Entwurf bleibt erhalten.');}
   const data=r.data;
   if(op==='list'){
    if(!Array.isArray(data?.items)||data.items.length>50||typeof data.hasMore!=='boolean'||typeof data.isAdmin!=='boolean'||data.items.some(p=>!Number.isSafeInteger(p.id)||p.id<1||typeof p.body!=='string'||typeof p.title!=='string'||typeof p.commander!=='string'||typeof p.createdAt!=='string'||!['open','planned','done'].includes(p.status)||typeof p.mine!=='boolean'||typeof p.deleted!=='boolean'||typeof p.voted!=='boolean'||!Number.isSafeInteger(p.votes)||p.votes<0))throw Error('Ungültige Community-Antwort.');
   }else if(!Number.isSafeInteger(data?.id)||data.id<1)throw Error('Ungültige Community-Bestätigung. Dein Entwurf bleibt erhalten.');
   return data;
  },
  async wishComments(wish,{op='list',id=null,body='',request=null}={}){if(!user)throw Error('Bitte anmelden.');const r=await client.rpc('imperium_wish_comments',{p_wish:wish,p_op:op,p_id:id,p_body:body,p_request:request});if(r.error){if(['PGRST202','42883','42P01'].includes(r.error.code))throw Error('Bitte zuerst supabase/wish-comments.sql installieren.');const messages={RATE_LIMIT:'Bitte 5 Sekunden zwischen Kommentaren warten.',FORBIDDEN:'Du kannst nur eigene Kommentare ausblenden.',INVALID_CONTENT:'Kommentar muss 1 bis 1000 Zeichen enthalten.',WISH_NOT_FOUND:'Dieser Wunsch ist nicht mehr verfügbar.'};throw Error(messages[r.error.message]||r.error.message||'Kommentare konnten nicht geladen werden.');}if(op==='list'&&(!Array.isArray(r.data?.items)||r.data.items.length>5000||r.data.items.some(x=>!Number.isSafeInteger(x.id)||typeof x.body!=='string'||typeof x.commander!=='string')))throw Error('Ungültige Kommentare.');return r.data;},
  async battleLog(mission,round=null,offset=0){if(!user)throw Error('Bitte anmelden.');const r=await client.rpc('imperium_battle_log',{p_mission:mission,p_round:round,p_offset:offset});if(r.error)throw r.error;return r.data;},
  async archiveReports(ids,archived){const r=await client.rpc('imperium_archive_reports',{p_ids:ids,p_archived:archived});if(r.error)throw r.error;return r.data;},
  async galaxyView(){if(!user)throw Error('Bitte anmelden, um die gemeinsame Galaxie zu laden.');const result=await client.rpc('imperium_galaxy_view');if(result.error){if(['PGRST202','42883','42P01'].includes(result.error.code))throw Error('Die gemeinsame Galaxie benötigt die einmalige Supabase-Erweiterung (supabase/galaxy.sql).');throw result.error;}return validateGalaxy(result.data);},
  async galaxySync(action={}){if(authoritative){const result=await this.gameRequest(action.kind?{type:'galaxy',action}:{type:'sync'});return {...result,galaxy:await this.galaxyView()};}if(!user||!loaded)throw Error('Cloud-Spielstand zuerst laden.');if(busy)throw Error('Speicherung läuft noch.');busy=true;try{const result=await client.rpc('imperium_galaxy_sync',{p_expected:revision,p_kind:action.kind||null,p_from:action.from||null,p_to:action.to||null});if(result.error){if(result.error.message?.includes('SAVE_CONFLICT')){loaded=false;throw new CloudConflict();}throw result.error;}const next=Number(result.data?.revision);if(!Number.isSafeInteger(next)||next<revision||next>revision+1)throw Error('Ungültige Galaxie-Version.');const state=validateSave(result.data.state),galaxy=validateGalaxy(result.data.galaxy);revision=next;return {state,galaxy};}finally{busy=false;}},
  async load(){if(!user)throw Error('Bitte anmelden.');if(busy)throw Error('Speicherung läuft noch.');loaded=false;if(client.functions?.invoke){const status=await client.rpc('imperium_pvp_status');if(status.error&&!['PGRST202','42883'].includes(status.error.code))throw status.error;if(!status.error){if(status.data?.version!==1)throw Error('Unbekannte Serverversion.');authoritative=true;busy=true;try{const result=await perform({type:'sync'});loaded=true;return result.state;}finally{busy=false;}}authoritative=false;}
 const row=checked(await client.from('game_saves').select('state,revision').eq('user_id',user.id).maybeSingle());const state=row?validateSave(row.state):null;revision=row?Number(row.revision):0;if(!Number.isSafeInteger(revision)||revision<0)throw Error('Ungültige Cloud-Version.');loaded=true;return state;},
  async save(state){if(authoritative)throw Error('Server-Spielstände werden durch Spielaktionen gespeichert; Import ist gesperrt.');if(!user||!loaded)throw Error('Cloud-Spielstand zuerst laden.');if(busy)throw Error('Speicherung läuft noch.');const snapshot=validateSave(state);busy=true;try{const result=await client.rpc('save_imperium',{p_state:snapshot,p_expected:revision});if(result.error){if(result.error.message?.includes('SAVE_CONFLICT')){loaded=false;throw new CloudConflict();}throw result.error;}const next=Number(result.data);if(next!==revision+1)throw Error('Cloud-Speicherung lieferte keine gültige Bestätigung.');revision=next;return next;}finally{busy=false;}}
 };
}
async function connectCloud(config){
 if(!config.enabled)return null;
 if(!/^https:\/\/[a-z0-9-]+\.supabase\.co\/?$/i.test(config.url)||!config.publishableKey)throw Error('Cloud-Konfiguration fehlt oder ist ungültig.');
 const {createClient}=await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.2/+esm');
 return createCloud(createClient(config.url,config.publishableKey,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}}),config.redirectUrl,config.commandFunction||'game-command');
}

// Passive views need fewer authoritative world writes. Events are caught up
// at their exact timestamps by advanceWorld() when the next sync runs.
const NORMAL_SYNC_MS = 30_000;
const ACTIVE_PVP_SYNC_MS = 15_000;

function shouldSyncCloud({now,lastAttempt=0,hidden=false,authoritative=false,dirty=false,pvp=null}){
 if(!authoritative&&!dirty)return false;
 // The server's authoritative world is advanced on the next foreground sync.
 // Legacy cloud saves must still be allowed while a tab is in the background.
 if(hidden&&authoritative)return false;
 const combatActive=authoritative&&(
  (Array.isArray(pvp?.outgoing)&&pvp.outgoing.length>0) ||
  (Array.isArray(pvp?.incoming)&&pvp.incoming.length>0)
 );
 return now-lastAttempt>=(combatActive?ACTIVE_PVP_SYNC_MS:NORMAL_SYNC_MS);
}


const uiArtRoot='./assets/pvp-resource-v1/';
const RESOURCE_ART=Object.fromEntries(['metal','crystal','fuel','energy'].map(k=>[k,uiArtRoot+'resources/'+k+'-128.webp']));
const ACTION_ART=Object.fromEntries(['attack','protection','repair','debris','pvpPause','cancelShip'].map(k=>[k,uiArtRoot+'actions/'+k+'-128.webp']));
const uiPicture=(src,cls)=>src?'<img class="'+cls+'" src="'+src+'" alt="" aria-hidden="true" width="32" height="32" decoding="async">':'';
function resourceIcon(key){return uiPicture(RESOURCE_ART[key],'resource-art');}
function actionIcon(key){return uiPicture(ACTION_ART[key],'action-art');}
const V3_SHIP_KEYS=new Set(['falke','waechter','donner','titan','kurier','transport','karawane','atlas','arche','spyProbe','probe','longProbe','colony','starColony']);
const V3_ORBITAL_KEYS=new Set(['flak','laser','rail','plasma']);
function unitImagePath(key){
 if(V3_ORBITAL_KEYS.has(key))return './assets/ship-concept-v3/orbital-'+key+'.png';
 return unitArtPath(key);
}
function unitArtPath(key){const sh=SHIPS[key];if(!sh)return '';return V3_ORBITAL_KEYS.has(key)?'./assets/ship-icons-v3/orbital-'+key+'.webp':V3_SHIP_KEYS.has(key)?'./assets/ship-icons-v3/'+key+'.webp':sh.asset?.replace('.webp','-128.webp')||'./assets/'+(sh.image||key)+'.webp';}
function unitIcon(key){return uiPicture(unitArtPath(key),'unit-art');}



const reportEscape=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const reportDate=t=>new Date(t).toLocaleString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
const reportNumber=n=>Math.floor(n||0).toLocaleString('de-DE');
const reportKinds={battle:'Gefecht',attack:'Angriff',return:'Rückkehr',transport:'Transport',scan:'Erkundung',colony:'Kolonisierung',other:'Sonstiges'};
const reportResults={win:'Sieg',loss:'Niederlage',draw:'Unentschieden',cancelled:'Abgebrochen'};
function reportPlanetName(id,state,galaxy){
 const owned=state?.planets?.find(p=>p.id===id);if(owned)return owned.name;
 const known=galaxy?.planets?.find(p=>p.id===id);if(known?.surveyed&&known.name)return known.name;
 const match=/^g-([a-z]+)-p(\d+)$/.exec(id||'');if(match){const system=galaxy?.systems?.find(s=>s.id===match[1]);return (system?.name||match[1][0].toUpperCase()+match[1].slice(1))+' '+match[2];}
 return id||'Unbekannt';
}
function reportFleet(f){return Object.entries(f||{}).filter(([,n])=>n).map(([k,n])=>reportNumber(n)+' × '+(SHIPS[k]?.name||k)).join(' · ')||'Keine';}
function reportCargo(c){return RES.filter(k=>c?.[k]).map(k=>reportNumber(c[k])+' '+LABEL[k]).join(' · ')||'Keine';}
function reportSide(r,state){
 const p=r.payload||{};
 if(['attacker','defender'].includes(p.ownSide))return p.ownSide;
 if(r.kind==='attack'||r.kind==='return')return 'attacker';
 // Current planet ownership cannot establish a player's historical role.
 return null;
}
function reportContext(r,state,galaxy){
 const p=r.payload||{},side=reportSide(r,state),own='Du'+(state?.name?' ('+state.name+')':''),unknown='Nicht im Bericht gespeichert';
 const attacker=p.attackerName||(side==='attacker'?own:side==='defender'?p.commander:null)||unknown;
 const defender=p.defenderName||(side==='defender'?own:side==='attacker'?p.commander:null)||unknown;
 const from=p.fromName||(p.from?side==='attacker'?reportPlanetName(p.from,state,galaxy):p.from.startsWith('g-')?reportPlanetName(p.from,null,galaxy):'Privates Heimatsystem ('+p.from+')':unknown);
 const to=p.toName||(p.to?reportPlanetName(p.to,state,galaxy):unknown);
 return {isSupport:p.isSupport,side,attacker,defender,from,to,perspective:p.isSupport?'Du hast mitverteidigt':side==='attacker'?'Du hast angegriffen':side==='defender'?'Du wurdest angegriffen':'Eigene Rolle nicht im Bericht gespeichert'};
}
function reportLosses(before,after){return Object.fromEntries(Object.entries(before||{}).map(([k,n])=>[k,Math.max(0,n-(after?.[k]||0))]));}
function reportForces(before,after,label){
 if(!before||!after)return '<p>'+reportEscape(label)+': Einheiten nicht im Bericht gespeichert.</p>';
 const keys=[...new Set([...Object.keys(before),...Object.keys(after)])].filter(k=>before[k]||after[k]);
 return '<div class="report-force-table"><table><caption>'+reportEscape(label)+'</caption><thead><tr><th scope="col">Einheit</th><th scope="col">Eingesetzt</th><th scope="col">Verloren</th><th scope="col">Überlebt</th></tr></thead><tbody>'+(keys.map(k=>'<tr><th scope="row">'+reportEscape(SHIPS[k]?.name||k)+(SHIPS[k]?.category==='defense'?'<small>Orbitale Verteidigung</small>':'')+'</th><td>'+reportNumber(before[k])+'</td><td>'+reportNumber(Math.max(0,(before[k]||0)-(after[k]||0)))+'</td><td>'+reportNumber(after[k])+'</td></tr>').join('')||'<tr><td colspan="4">Keine Einheiten eingesetzt.</td></tr>')+'</tbody></table></div>';
}
function reportParticipants(r,state,galaxy){
 const c=reportContext(r,state,galaxy);
 return '<p class="report-perspective">'+reportEscape(c.perspective)+'</p><div class="report-participants"><section><h4>⚔ Angreifer'+(c.side==='attacker'?' · Du':'')+'</h4><strong>'+reportEscape(c.attacker)+'</strong><p>Startplanet: '+reportEscape(c.from)+'</p></section><section><h4>🛡 Verteidiger'+(c.side==='defender'&&!c.isSupport?' · Du':'')+'</h4><strong>'+reportEscape(c.defender)+'</strong><p>Verteidigter Planet: '+reportEscape(c.to)+'</p></section></div><p>Angriffsroute: '+reportEscape(c.from)+' → '+reportEscape(c.to)+'</p>';
}
function fallbackReports(state,pvp){
 const local=state.reports.filter(r=>r.title!=='PvP-Kampfbericht').map(r=>({...r,id:'local:'+r.id,kind:/sonde|entdeck/i.test(r.title)?'scan':/koloni/i.test(r.title)?'colony':/transport|liefer|route|flotte/i.test(r.title)?'transport':'other',archived:false,payload:{}}));
 const battles=(pvp?.reports||[]).map(r=>({id:'attack:'+r.id+':battle',time:r.at,kind:'battle',title:'Gefecht',missionId:r.id,payload:r,outcome:r.outcome==='draw'?'draw':r.outcome==='cancelled'?'cancelled':reportSide({kind:'battle',payload:r},state)?(r.outcome===reportSide({kind:'battle',payload:r},state)?'win':'loss'):null,archived:false}));
 return [...local,...battles].sort((a,b)=>b.time-a.time||b.id.localeCompare(a.id));
}
function reportDetail(r,state,galaxy){
 const p=r.payload||{},combat=['battle','attack','return'].includes(r.kind),participants=combat?reportParticipants(r,state,galaxy):'';
 if(r.kind==='battle'){
  const result=p.outcome==='attacker'?'Sieg des Angreifers':p.outcome==='defender'?'Sieg des Verteidigers':p.outcome==='draw'?'Unentschieden':p.outcome==='cancelled'?'Angriff abgebrochen':reportResults[r.outcome]||'Ergebnis nicht gespeichert';
  const header=participants+'<p class="report-result"><strong>Ergebnis: '+reportEscape(result)+'</strong></p>';
  if(p.reason)return header+'<p>'+reportEscape(p.reason)+'</p>';
  const side=reportSide(r,state),before=p.ownBefore??p[(side||'attacker')+'Before'],after=p.ownAfter??p[(side||'attacker')+'After'],loss=before&&after?reportNumber(Object.values(reportLosses(before,after)).reduce((a,n)=>a+n,0)):'Nicht gespeichert';
  const survivors=p.attackerAfter?Object.values(p.attackerAfter).some(n=>n>0):null;
  return header+'<div class="report-metrics"><div><small>'+(side?'Eigene Verluste':'Verluste Angreifer')+'</small><strong>'+loss+'</strong></div><div><small>Beute des Angreifers</small><strong>'+reportEscape(reportCargo(p.loot))+'</strong></div><div><small>Kampfrunden</small><strong>'+(p.rounds?.length??'Nicht gespeichert')+'</strong></div></div>'+reportForces(p.attackerBefore,p.attackerAfter,'Angreifer · Flotte')+reportForces(p.defenderBefore,p.defenderAfter,'Verteidiger · Flotte und orbitale Verteidigung')+(p.supporting||[]).map(g=>reportForces(g.before,g.after,'Unterstützung · '+g.commander)).join('')+'<p>'+actionIcon('debris')+'Vom Angreifer geborgene Trümmer: '+reportEscape(reportCargo(p.salvage))+'</p><p>'+actionIcon('debris')+'Verbleibende Trümmer am Ziel: '+reportEscape(reportCargo(p.debrisLeft))+'</p>'+(p.defenseRepair?'<p>Reparaturmaterial des Verteidigers: '+reportEscape(reportCargo(p.defenseRepair))+'</p>':'')+(survivors===false?'<p>Keine Angreiferschiffe überlebt · kein Rückflug.</p>':survivors&&p.returnAt?'<p>Geplante Heimkehr der Angreiferflotte: '+reportEscape(reportDate(p.returnAt))+'</p>':'')+(p.traceAvailable?'<button data-action="battle-log" data-mission="'+reportEscape(r.missionId||p.id)+'">Vollständiges Kampfprotokoll öffnen</button>':'<p class="fine">Historischer Bericht: Einzelne Schüsse und Hüllenzustände wurden damals nicht gespeichert.</p>');
 }
 return participants+(r.body?'<p>'+reportEscape(r.body)+'</p>':'')+(p.fleet?'<p>'+(r.kind==='return'?'Zurückgekehrte Angreiferflotte':r.kind==='attack'?'Eingesetzte Angreiferflotte':'Flotte')+': '+reportEscape(reportFleet(p.fleet))+'</p>':'')+(p.cargo?'<p>'+(r.kind==='return'?'Zurückgebrachte Ladung':'Ladung')+': '+reportEscape(reportCargo(p.cargo))+'</p>':'');
}
const reportIconPaths={
 battle:'<path d="M5 3l16 16-3 3L2 6V3h3zm14 0h2v3l-6 6-3-3 7-6zM3 21l6-6"/>',
 attack:'<path d="M4 19 20 4m-9 0h9v9M4 5l5 5M4 12l4 4"/>',
 return:'<path d="M9 14 4 9l5-5M4 9h10a6 6 0 0 1 0 12h-3"/>',
 transport:'<path d="M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4"/>',
 scan:'<circle cx="11" cy="11" r="7"/><path d="m16 16 5 5M8 11h6m-3-3v6"/>',
 colony:'<circle cx="12" cy="12" r="8"/><path d="M4.5 15.5 19.5 8M12 2v4m0 12v4M2 12h4m12 0h4"/>',
 other:'<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>'
};
function reportIcon(kind){return '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">'+reportIconPaths[kind]+'</svg>';}
function reportRows(items,state,galaxy,{selectable=false,selected=new Set(),opened=new Set()}={}){
 if(!items.length)return '<p class="muted report-empty">Keine passenden Berichte.</p>';
 let day='';
 return items.map(original=>{
  const related=original.missionId&&items.find(q=>q.kind==='battle'&&q.missionId===original.missionId&&q.payload?.ownSide==='attacker');
  const r=related&&['attack','return'].includes(original.kind)?{...original,payload:{...original.payload,commander:original.payload?.commander||related.payload.commander}}:original;
  const stamp=new Date(r.time),date=stamp.toLocaleDateString('de-DE'),group=date!==day?'<h3 class="report-day">'+reportEscape(date)+'</h3>':'';day=date;
  const p=r.payload||{},place=p.to?reportPlanetName(p.to,state,galaxy):'',kind=Object.hasOwn(reportKinds,r.kind)?r.kind:'other';
  const badge=reportResults[r.outcome]||(p.outcome==='attacker'?'Angreifer gewinnt':p.outcome==='defender'?'Verteidiger gewinnt':'');
  const detailLine=['battle','attack','return'].includes(r.kind)?[reportContext(r,state,galaxy).perspective,place,p.commander]:[place,p.commander];
  const caption=detailLine.filter(Boolean).join(' · ')||'Berichtsdetails ansehen';
  return group+'<div class="report-list-row report-kind-'+kind+'">'+
   (selectable?'<input class="report-select" type="checkbox" data-report-select="'+reportEscape(r.id)+'" aria-label="Bericht auswählen: '+reportEscape(r.title||reportKinds[kind])+'" '+(selected.has(r.id)?'checked':'')+'>':'')+
   '<details data-report-id="'+reportEscape(r.id)+'" '+(opened.has(r.id)?'open':'')+'>'+
   '<summary><span class="report-row-symbol" aria-hidden="true">'+reportIcon(kind)+'</span>'+
   '<span class="report-row-copy"><strong>'+reportEscape(r.title||reportKinds[kind])+'</strong><small>'+reportEscape(caption)+'</small></span>'+
   '<time datetime="'+stamp.toISOString()+'"><span class="report-date-full">'+reportEscape(reportDate(r.time))+'</span><span class="report-date-short">'+reportEscape(stamp.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'}))+'</span></time>'+
   '<span class="report-badge '+reportEscape(r.outcome||'')+'">'+reportEscape(badge||reportKinds[kind]||'Ereignis')+'</span>'+
   '<span class="report-chevron" aria-hidden="true">⌄</span></summary>'+
   '<div class="report-detail">'+reportDetail(r,state,galaxy)+'</div></details></div>';
 }).join('');
}
function filterReports(items,filters,now){
 const since=filters.days?now-Number(filters.days)*86400000:0,q=(filters.search||'').trim().toLocaleLowerCase('de-DE');
 return items.filter(r=>!!r.archived===!!filters.archived&&(!filters.kind||r.kind===filters.kind)&&(!filters.outcome||r.outcome===filters.outcome)&&r.time>=since&&[r.title,r.body,r.payload?.from,r.payload?.to,r.payload?.commander].join(' ').toLocaleLowerCase('de-DE').includes(q));
}
function reportsPage(data,filters,state,galaxy,{busy=false,error='',selected=new Set(),opened=new Set(),durable=false}={}){
 const options=(map,value)=>'<option value="">Alle</option>'+Object.entries(map).map(([k,v])=>'<option value="'+k+'" '+(value===k?'selected':'')+'>'+v+'</option>').join('');
 return '<div class="page-heading"><span class="eyebrow">EREIGNISSE & EINSÄTZE</span><h1>Berichte</h1><p>Neueste Ereignisse zuerst. Öffne eine Zeile für alle Details.</p></div><div class="report-tabs" role="tablist" aria-label="Berichtsbereiche"><button role="tab" aria-selected="'+!filters.archived+'" data-action="report-view" data-archived="false">Übersicht</button><button role="tab" aria-selected="'+!!filters.archived+'" data-action="report-view" data-archived="true">Archiv</button></div><section class="panel"><form id="report-filters" class="report-filters"><label>Suche<input name="search" maxlength="80" value="'+reportEscape(filters.search)+'" placeholder="Planet oder Spieler suchen"></label><label>Typ<select name="kind">'+options(reportKinds,filters.kind)+'</select></label><label>Ergebnis<select name="outcome">'+options(reportResults,filters.outcome)+'</select></label><label>Zeitraum<select name="days">'+[['','Alle Zeiträume'],['1','Letzte 24 Stunden'],['7','Letzte 7 Tage'],['30','Letzte 30 Tage']].map(([k,v])=>'<option value="'+k+'" '+(String(filters.days||'')===k?'selected':'')+'>'+v+'</option>').join('')+'</select></label><button type="submit">Filtern</button></form>'+(filters.mission?'<p class="notice">Berichte dieses Einsatzes · <button data-action="reports-open">Alle Berichte anzeigen</button></p>':'')+(!durable?'<p class="notice">'+reportEscape(error||'Hier siehst du die noch gespeicherten Berichte. Das dauerhafte Archiv benötigt die SQL-Erweiterung reports.sql.')+'</p>':'')+'<div class="report-toolbar"><span>'+selected.size+' ausgewählt · '+data.total+' Bericht(e)</span><button data-action="report-archive" '+(!selected.size||!durable||busy?'disabled':'')+'>'+(filters.archived?'Wiederherstellen':'Archivieren')+'</button><button data-action="report-refresh" '+(busy?'disabled':'')+'>Aktualisieren</button></div>'+(error&&durable?'<p role="alert">'+reportEscape(error)+'</p>':'')+'<div id="report-list" aria-busy="'+busy+'">'+reportRows(data.items,state,galaxy,{selectable:durable,selected,opened})+'</div>'+(data.items.length<data.total?'<button data-action="report-more" '+(busy?'disabled':'')+'>Weitere Berichte laden</button>':'')+'</section>';
}


const number=n=>Number(n||0).toLocaleString('de-DE',{maximumFractionDigits:2});
const side=s=>s==='attacker'?'Angreifer':'Verteidiger';

// Read every page before aggregating. Never infer outcomes from a partial page.
async function loadBattleRound(read,mission,round){
 const first=await read(mission,round,0),shots=[...first.shots],impacts=[...first.impacts];
 const total=Math.max(first.shotTotal,first.impactTotal),limit=first.limit||200;
 for(let offset=limit;offset<total;offset+=limit){const page=await read(mission,round,offset);shots.push(...page.shots);impacts.push(...page.impacts);}
 if(shots.length!==first.shotTotal||impacts.length!==first.impactTotal)throw Error('Die Runde konnte nicht vollständig geladen werden.');
 return {...first,shots,impacts};
}

function summarizeRound(header,page){
 const units=new Map(header.initial.map(u=>[u.id,u])),pairs=new Map(),contributors=new Map();
 for(const shot of page.shots){
  const shooter=units.get(shot.shooter),target=units.get(shot.target);
  if(!shooter||!target)throw Error('Einheit im Kampfprotokoll fehlt.');
  const key=JSON.stringify([shooter.side,shooter.key,target.side,target.key]);
  if(!pairs.has(key))pairs.set(key,{shooter,target,shots:0,damage:0});
  const pair=pairs.get(key);pair.shots++;pair.damage+=shot.damage;
  if(!contributors.has(shot.target))contributors.set(shot.target,new Map());
  contributors.get(shot.target).set(shooter.key,shooter.name);
 }
 const outcomes=new Map();
 for(const hit of page.impacts){
  const target=units.get(hit.target),sources=[...(contributors.get(hit.target)||new Map())].sort(([a],[b])=>a.localeCompare(b));
  if(!target||!sources.length)throw Error('Treffer im Kampfprotokoll nicht zuordenbar.');
  const key=JSON.stringify([target.side,target.key,sources.map(([key])=>key)]);
  if(!outcomes.has(key))outcomes.set(key,{target,sources:sources.map(([,name])=>name),shield:0,hull:0,overkill:0,destroyed:0,surviving:0,hpAfter:0});
  const row=outcomes.get(key);row.shield+=hit.shieldDamage;row.hull+=hit.hullDamage;row.overkill+=hit.overkill;
  row.destroyed+=Number(hit.destroyed);row.surviving+=Number(!hit.destroyed);row.hpAfter+=hit.hpAfter;
 }
 return {pairs:[...pairs.values()],outcomes:[...outcomes.values()]};
}

function roundSummaryView(header,page){
 if(header.version===2){
  const pairs=page.shots||[],impacts=page.impacts||[];
  return '<section class="battle-round-summary"><h3>Runde '+page.round+
   (page.round===0?' · Orbitaler Erstschlag':' · Schlagabtausch')+
   '</h3><p class="fine">Kompakte Hybrid-Kampfberechnung: Einträge je Schiffstyp, keine einzelnen Schüsse gespeichert.</p>'+
   pairs.map(p=>'<article class="battle-exchange"><strong>'+reportEscape(p.shooter)+' → '+reportEscape(p.target)+'</strong><p>'+number(p.shots)+' Schüsse · '+number(p.damage)+' Schaden</p></article>').join('')+
   '<h4>Schäden und Verluste</h4>'+
   impacts.map(p=>'<article class="battle-impact-summary"><strong>'+reportEscape(p.key)+' · Gruppe '+reportEscape(p.groupId||'')+'</strong><p>'+
   number(p.hitUnits)+' getroffen · '+number(p.shieldDamage)+' Schildschaden · '+number(p.hullDamage)+' Hüllenschaden</p><p>'+
   (p.destroyed?'💥 '+number(p.destroyed)+' zerstört':'Keine Verluste')+
   (p.overkill?' · '+number(p.overkill)+' Überschaden':'')+'</p></article>').join('')+
   (!pairs.length?'<p>Keine Schüsse in dieser Runde.</p>':'')+'</section>';
 }

 const {pairs,outcomes}=summarizeRound(header,page);
 const label=u=>reportEscape(u.name)+' <small>'+side(u.side)+'</small>';
 return '<section class="battle-round-summary"><h3>Runde '+page.round+(page.round===0?' · Orbitaler Erstschlag':' · Schlagabtausch')+'</h3><p class="fine">'+(page.round===0?'Nur Orbitalplattformen feuern. Angreifer können in Runde 0 nicht zurückschießen.':'Beide Seiten feuern gleichzeitig. Verluste gelten am Rundenende.')+'</p>'+pairs.map(p=>'<article class="battle-exchange"><strong>'+label(p.shooter)+' → '+label(p.target)+'</strong><p>'+number(p.shots)+' Schüsse · '+number(p.damage)+' berechneter Schaden</p></article>').join('')+'<h4>Was wurde beschädigt oder zerstört?</h4>'+outcomes.map(o=>'<article class="battle-impact-summary"><strong>'+label(o.target)+' · getroffen von '+reportEscape(o.sources.join(' + '))+'</strong><p>'+number(o.shield)+' Schild + '+number(o.hull)+' Hülle beschädigt</p><p class="'+(o.destroyed?'battle-loss':'')+'">'+(o.destroyed?'💥 '+number(o.destroyed)+' zerstört':'Keine Zerstörung')+(o.surviving?' · '+number(o.surviving)+' getroffene Einheiten überleben mit insgesamt '+number(o.hpAfter)+' Hülle':'')+'</p>'+(o.overkill?'<small>'+number(o.overkill)+' Überschaden · nicht auf andere Ziele übertragen</small>':'')+(o.sources.length>1?'<small>Gemeinsames Trefferergebnis; kein einzelner Klasse zugeschriebener Abschuss.</small>':'')+'</article>').join('')+(!pairs.length?'<p>Keine Schüsse in dieser Runde.</p>':'')+'</section>';
}


const battleNumber=n=>Number(n||0).toLocaleString('de-DE',{maximumFractionDigits:2});
function hybridBattleLogView(header,page,{round=-2,offset=0}={}){
 const control=(text,r,o=0,disabled=false)=>'<button data-battle-round="'+r+'" data-battle-offset="'+o+'" '+(disabled?'disabled':'')+' aria-pressed="'+(r===round&&o===offset)+'">'+text+'</button>';
 const nav=control('Start',-2)+(header.rounds||[]).map(q=>control(q.round===0?'Runde 0 · Orbitaler Erstschlag':'Runde '+q.round,q.round)).join('')+control('Ende',-1);
 const initial={attacker:0,defender:0};for(const g of header.initialGroups||[])initial[g.side]=(initial[g.side]||0)+g.count;
 const after=round===-2?{attacker:{count:initial.attacker},defender:{count:initial.defender}}:round===-1?(header.rounds||[]).at(-1)?.after||{attacker:{count:initial.attacker},defender:{count:initial.defender}}:page?.after;
 const board=after?'<div class="battle-board">'+['attacker','defender'].map(side=>'<section><h3>'+(side==='attacker'?'Angreifer':'Verteidiger')+(side===header.ownSide?' · Du':'')+'</h3><p>'+reportEscape(header.participants?.[side]||'Commander')+'</p><strong>'+battleNumber(after[side]?.count||0)+' / '+battleNumber(initial[side])+' Einheiten</strong><progress max="'+Math.max(1,initial[side])+'" value="'+(after[side]?.count||0)+'"></progress></section>').join('')+'</div>':'';
 let body='',total=0;
 if(round<0){
  const groups=round===-2?header.initialGroups||[]:header.finalGroups||[];
  total=groups.length;
  body='<h3>'+(round===-2?'Startzustand':'Endzustand')+' · Kampfgruppen</h3><div class="battle-units">'+groups.slice(offset,offset+200).map(g=>'<article><strong>'+reportEscape(g.key)+'</strong><p>'+battleNumber(g.count)+' Einheiten · '+(g.side==='attacker'?'Angreifer':'Verteidiger')+'</p>'+(g.owner?'<small>'+reportEscape(g.owner)+'</small>':'')+'</article>').join('')+'</div>';
 }else if(page){
  total=Math.max(page.shotTotal||0,page.impactTotal||0);
  body='<h3>Aggregierte Schüsse und Treffer</h3><div class="battle-shot-table"><table><thead><tr><th>Schütze → Ziel</th><th>Schüsse</th><th>Schaden</th></tr></thead><tbody>'+(page.shots||[]).map(p=>'<tr><td>'+reportEscape(p.shooter)+' → '+reportEscape(p.target)+'</td><td>'+battleNumber(p.shots)+'</td><td>'+battleNumber(p.damage)+'</td></tr>').join('')+'</tbody></table></div><h3>Treffer nach Gruppe</h3><div class="battle-units">'+(page.impacts||[]).map(p=>'<article><strong>'+reportEscape(p.key)+'</strong><p>'+battleNumber(p.hitUnits)+' getroffen · '+battleNumber(p.destroyed)+' zerstört</p><small>Schild '+battleNumber(p.shieldDamage)+' · Hülle '+battleNumber(p.hullDamage)+' · Überschaden '+battleNumber(p.overkill)+'</small></article>').join('')+'</div>';
 }
 const details=body?'<details class="battle-raw-details"><summary>Gruppendetails anzeigen</summary>'+body+'</details>':'';
 const pages=total>200?'<div class="battle-pages">'+control('← Zurück',round,Math.max(0,offset-200),offset===0)+'<span>'+Math.min(total,offset+1)+'–'+Math.min(total,offset+200)+' / '+total+'</span>'+control('Weiter →',round,offset+200,offset+200>=total)+'</div>':'';
 const summaries=(header.rounds||[]).map(q=>'<tr><td>'+q.round+'</td><td>'+battleNumber(q.after?.attacker?.count)+'</td><td>'+battleNumber(q.after?.defender?.count)+'</td></tr>').join('');
 return '<h2>Kampfprotokoll · Hybrid v'+header.ruleVersion+'</h2><p>'+reportEscape(header.from||'')+' → '+reportEscape(header.to||'')+'</p><p class="fine">Kompakter Kampfbericht. Treffer werden nach Typ und Gruppe zusammengefasst; individuell beschädigte Schiffe bleiben im Reparatursystem erhalten.</p>'+ (header.ruleVersion===7?'<p class="fine">v7: Zufällige Ziele ohne Rapid-Fire-Priorität. Zielbindung bis zur Zerstörung; Zusatzsalven bleiben auf demselben Ziel. Der nächste normale Schuss wechselt nach einem Abschuss. Alle zu Rundenbeginn lebenden Einheiten feuern gleichzeitig; in Runde 0 nur die Orbitalverteidigung.</p>':'')+'<div class="battle-round-nav">'+nav+'</div>'+board+pages+(page?.summaryHTML||'')+details+pages+
 '<details><summary>Überlebende je Runde</summary><table><thead><tr><th>Runde</th><th>Angreifer</th><th>Verteidiger</th></tr></thead><tbody>'+summaries+'</tbody></table></details><details><summary>Reproduzierbarkeit</summary><p>Seed: <code>'+reportEscape(header.seed||'')+'</code></p></details>';
}
function battleLogView(header,page=null,{round=-2,offset=0}={}){
 if(header.version===2)return hybridBattleLogView(header,page,{round,offset});
 const units=new Map(header.initial.map(u=>[u.id,u]));
 const label=id=>{const u=units.get(id);return (u?.name||u?.key||'Einheit')+' · '+id+(u?.commander?' · '+u.commander:'');};
 const control=(text,r,o=0,disabled=false)=>'<button data-battle-round="'+r+'" data-battle-offset="'+o+'" '+(disabled?'disabled':'')+' aria-pressed="'+(r===round&&o===offset)+'">'+text+'</button>';
 const nav=control('Start',-2)+header.rounds.map(q=>control(q.round===0?'Runde 0 · Orbitaler Erstschlag':'Runde '+q.round,q.round)).join('')+control('Ende',-1);
 const reason={bonus:'Passendes Bonusziel',military:'Kriegsschiff hat Vorrang',defense:'Orbitale Verteidigung hat Vorrang',civil:'Keine Kriegsschiffe oder Verteidigungen übrig'};
 const summaries=header.rounds.map(q=>'<tr><th scope="row">'+q.round+'</th><td>'+q.after.attacker.count+'</td><td>'+q.after.defender.count+'</td></tr>').join('');
 const initial={attacker:header.initial.filter(u=>u.side==='attacker').length,defender:header.initial.filter(u=>u.side==='defender').length};
 const after=round===-2?Object.fromEntries(Object.entries(initial).map(([side,count])=>[side,{count}])):round===-1?header.rounds.at(-1)?.after||Object.fromEntries(Object.entries(initial).map(([side,count])=>[side,{count}])):page?.after;
 const board=after?'<div class="battle-board">'+['attacker','defender'].map(side=>'<section><h3>'+(side==='attacker'?'Angreifer':'Verteidiger')+(side===header.ownSide?' · Du':'')+'</h3><p>'+reportEscape(header.participants?.[side]||'Commander')+'</p><strong>'+after[side].count+' / '+initial[side]+' Einheiten</strong><progress max="'+Math.max(1,initial[side])+'" value="'+after[side].count+'" aria-label="Verbleibende '+side+'"></progress>'+(after[side].hp!==undefined?'<small>Hülle insgesamt: '+battleNumber(after[side].hp)+' · Schild: '+battleNumber(after[side].shield)+'</small>':'')+'</section>').join('')+'</div>':'';
 let body='',total=0;
 if(round<0){const list=round===-2?header.initial:header.final;total=list.length;body='<h3>'+(round===-2?'Startzustand':'Endzustand')+' jeder Einheit</h3><div class="battle-units">'+list.slice(offset,offset+200).map(u=>'<article><strong>'+reportEscape(label(u.id))+'</strong><small>'+(u.side==='attacker'?'Angreifer':'Verteidiger')+' · '+reportEscape(u.category)+'</small><p>Hülle '+battleNumber(u.hp)+' / '+battleNumber(u.maxHp)+' · Schild '+battleNumber(u.shield)+' / '+battleNumber(u.maxShield)+'</p><progress max="'+u.maxHp+'" value="'+u.hp+'" aria-label="Hülle"></progress><small>Angriff '+battleNumber(u.attack)+' · '+u.shots+' Schuss/Schüsse</small></article>').join('')+'</div>';}
 else if(page){
  total=Math.max(page.shotTotal,page.impactTotal);
  body='<h3>Runde '+round+' · Gleichzeitig verrechneter Schaden</h3><p>'+(round===0?'Nur Orbitalplattformen der Verteidiger eröffnen das Feuer. Angreifer schießen nicht zurück.':'Alle zu Rundenbeginn lebenden Einheiten schießen.')+' Die Zeilenreihenfolge ist keine zeitliche Trefferfolge. Überzähliger Schaden wird nicht auf andere Ziele verteilt.</p><div class="battle-units">'+page.impacts.map(hit=>{const u=units.get(hit.target);return '<article class="'+(hit.destroyed?'battle-destroyed':'')+'"><strong>'+reportEscape(label(hit.target))+'</strong><p>'+battleNumber(hit.damage)+' Schaden erhalten</p><small>Schild absorbiert: '+battleNumber(hit.shieldDamage)+' · Hülle verloren: '+battleNumber(hit.hullDamage)+' · Überschaden: '+battleNumber(hit.overkill)+'</small><p>HP '+battleNumber(hit.hpBefore)+' → '+battleNumber(hit.hpAfter)+' · Schild '+battleNumber(hit.shieldBefore)+' → '+battleNumber(hit.shieldAfter)+'</p><progress max="'+(u?.maxHp||1)+'" value="'+hit.hpAfter+'" aria-label="Verbleibende Hülle"></progress>'+(hit.destroyed?'<strong>Zerstört am Rundenende</strong>':'')+'</article>';}).join('')+'</div><h3>Einzelne Schüsse · '+page.shotTotal+' insgesamt</h3><div class="battle-shot-table"><table><thead><tr><th>Schütze → Ziel</th><th>Berechnung</th><th>Zielwahl</th></tr></thead><tbody>'+page.shots.map(s=>'<tr><td>'+reportEscape(label(s.shooter))+'<br>→ '+reportEscape(label(s.target))+'<small>Schuss '+s.shot+'</small></td><td>'+battleNumber(s.base)+' × '+battleNumber(1+s.bonus)+' = <strong>'+battleNumber(s.damage)+'</strong></td><td>'+reportEscape(reason[s.reason]||s.reason)+'</td></tr>').join('')+'</tbody></table></div>';
 }
 body=(page?.summaryHTML||'')+'<details class="battle-raw-details"><summary>'+(round>=0?'Einzelne Treffer und Schüsse anzeigen':'Einzelne Schiffe anzeigen')+'</summary>'+body+'</details>';
 const pages=total>200?'<div class="battle-pages">'+control('← Vorherige Seite',round,Math.max(0,offset-200),offset===0)+'<span>Einträge '+(offset+1)+'–'+Math.min(total,offset+200)+' / '+total+'</span>'+control('Nächste Seite →',round,offset+200,offset+200>=total)+'</div>':'';
 return '<h2>Kampfprotokoll · Regelversion '+header.ruleVersion+'</h2><p>'+reportEscape(header.from)+' → '+reportEscape(header.to)+'</p><p>Bonusziele zuerst; danach Kriegsschiffe, Verteidigung und zivile Schiffe. Frachter und zivile Schiffe sind geschützt, solange auf ihrer Seite Kriegsschiffe leben.'+(header.ruleVersion>=3?' In Runde 0 feuern nur Orbitalplattformen der Verteidiger.':'')+'</p><div class="battle-round-nav">'+nav+'</div>'+board+pages+body+pages+'<details><summary>Forschung und Reproduzierbarkeit</summary><p>Seed: <code>'+reportEscape(header.seed)+'</code></p>'+['attacker','defender'].map(side=>'<p>'+(side==='attacker'?'Angreifer':'Verteidiger')+': Waffen '+(header.tech[side].weapons||0)+' · Schilde '+(header.tech[side].shields||0)+' · Panzerung '+(header.tech[side].armor||0)+' · Schildbereitschaft '+battleNumber(100*header.shieldFactors[side])+' %</p>').join('')+'</details><details><summary>Überlebende je Runde</summary><table><thead><tr><th>Runde</th><th>Angreifer</th><th>Verteidiger</th></tr></thead><tbody>'+summaries+'</tbody></table></details>';
}
