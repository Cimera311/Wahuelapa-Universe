function fleetManifest(m){return m.fleet||{[m.ship]:m.count};}
function checkedFleet(fleet){if(!fleet||typeof fleet!=='object'||Array.isArray(fleet)||!Object.keys(fleet).length||Object.entries(fleet).some(([k,n])=>!isFreighter(k)||!Number.isSafeInteger(n)||n<1))throw Error('Wähle verfügbare Frachter in positiven ganzen Zahlen.');return {...fleet};}
