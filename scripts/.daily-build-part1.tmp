// Betriebsparameter separat halten: sync-policy.js (30/15 s), server-service.js
// (5 Versuche), server-world.js (10.000 globale Events), engine.js (100.000 lokale
// Events), reports.sql (50 pro Seite), pvp.sql (30 Tage Snapshot-Historie).
// Keine frei änderbaren Realm-Regeln: Schema-/Engine-Versionen, UUIDs, RNG-Konstanten,
// Rundungspräzision, Zeitumrechnung, Sicherheitsprüfungen und historische Refunds.



// Read the same Test4 values that the v6/v7 battle engines use. Never duplicate
// Rapid Fire percentages in the UI, so balance changes are reflected here.
const escapeHTML=value=>String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const percent=value=>Number((value*100).toFixed(1)).toLocaleString('de-DE');

function rapidFireTargets(key,combat=combatConfigForRealmId('test4').rapidFire){
 if(!combat.enabled)return [];
 return Object.entries(combat.chances[key]||{})
  .filter(([target,chance])=>SHIPS[target]&&Number.isFinite(chance)&&chance>0)
  .map(([target,chance])=>({key:target,name:SHIPS[target].name,chance}));
}

function rapidFireInfoHTML(key,engineVersion=null){
 const sh=SHIPS[key];
 if(!sh)return '';
 const combat=combatConfigForRealmId('test4').rapidFire;
 const entries=rapidFireTargets(key,combat);
 const active=[6,7].includes(engineVersion);
 const legacy=engineVersion!=null&&!active;
 const subtitle=active?'v'+engineVersion+' aktiv':legacy?'Nur bei v6 / v7':'Kampfengine v6 / v7';
 const chips=entries.map(({name,chance})=>`<span class="ship-rapid-fire-target"><span>${escapeHTML(name)}</span><strong>${percent(chance)} %</strong></span>`).join('');
 const description=!['military','defense'].includes(sh.category)
  ?'<p class="fine">Keine Rapid-Fire-Funktion für diesen Schiffstyp.</p>'
  :!entries.length
   ?'<p class="fine">Keine Rapid-Fire-Ziele konfiguriert.</p>'
   :`<div class="ship-rapid-fire-targets">${chips}</div><p class="fine">Chance auf eine weitere vollständige Salve gegen das jeweilige Ziel, nach jeder Zusatzsalve erneut geprüft. Maximal ${combat.maxExtraSalvos} Zusatzsalven pro Einheit und Kampfrunde.${sh.category==='defense'?(combat.allowInOrbitalOpening?' Rapid Fire gilt auch beim orbitalen Erstschlag (Runde 0).':' Kein Rapid Fire beim orbitalen Erstschlag.') :''}</p>`;
 return `<section class="ship-rapid-fire" aria-label="Rapid Fire"><div class="ship-rapid-fire-heading"><strong>⚡ Rapid Fire</strong><small>${subtitle}</small></div>${description}${engineVersion===7&&entries.length?'<p class="fine">v7: Normale Schüsse bleiben bis zur Zerstörung am Ziel. Jeder normale Schuss kann Rapid Fire auslösen; Zusatzsalven bleiben auf demselben Ziel, auch bei Überschaden. Erst der nächste normale Schuss wählt nach einer Zerstörung neu. Keine Bevorzugung von Rapid-Fire-Zielen.</p>':''}${legacy?`<p class="fine ship-rapid-fire-inactive">Aktuell gilt v${engineVersion} ohne Rapid Fire. Die Werte gelten bei Aktivierung von v6 oder v7.</p>`:''}</section>`;
}



const GALAXY_FLIGHT_RULE_VERSION=4;
// REALM-CANDIDATE[engineBonuses]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
const ENGINE_SPEED_BONUS=.05;
const ENGINE_FUEL_BONUS=.12;
// Retain former level-five flight times while opening levels six through ten.
const FLIGHT_BASE_SCALE=1.25/1.6;
// Every private planet shares the account's galaxy entrance at slot zero.
// REALM-CANDIDATE[distance]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function sharedDistance(from,to,start){
 if(from.system&&from.system===to.system)return Math.max(1,Math.abs((from.slot||from.distance||0)-(to.slot||to.distance||0))*.15);
 const a=from.system?from:{...start,slot:0},b=to.system?to:{...start,slot:0};
 if(![a.x,a.y,b.x,b.y].every(Number.isFinite))throw Error('Der persönliche Galaxie-Startplatz fehlt. Bitte die Galaxie aktualisieren.');
 return Math.max(1,Math.hypot(a.x-b.x,a.y-b.y)/40+Math.abs((a.slot||0)-(b.slot||0))*.15);
}
// REALM-CANDIDATE[flightBase]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function sharedFlight(s,from,to,count=1,ship='transport',start=s.galaxy){
 const def=SHIPS[ship];if(!def||def.speed<=0)throw Error('Unbekanntes oder unbewegliches Schiff.');
 const distance=sharedDistance(from,to,start),remote=(from.system||'tutorial')!==(to.system||'tutorial');
 const engine=shipFlightEngine(s,ship,remote),factor=1+(s.tech[engine]||0)*ENGINE_SPEED_BONUS,fuelFactor=1+(s.tech[engine]||0)*ENGINE_FUEL_BONUS;
 return {distance,ms:Math.ceil(Math.max(60000,Math.ceil((120+distance*45)*FLIGHT_BASE_SCALE*1000/(def.speed*factor)))*REALM_CONFIG.galaxyFlightTimeFactor),fuel:Math.ceil(def.fuel*distance*count/fuelFactor)};
}


// Public navigation only. Ownership is public; planet properties are supplied by the server after surveying.
// REALM-CANDIDATE[galaxyLayout]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
const GALAXY_SYSTEMS=[
 {id:'helion',name:'Helion',x:520,y:400},{id:'orion',name:'Orion',x:380,y:250},
 {id:'cetus',name:'Cetus',x:220,y:450},{id:'aster',name:'Aster',x:600,y:180},
 {id:'lysara',name:'Lysara',x:750,y:300},{id:'vela',name:'Vela',x:850,y:180},
 {id:'umbra',name:'Umbra',x:760,y:650},{id:'nyx',name:'Nyx',x:520,y:720},
 {id:'solace',name:'Solace',x:870,y:730},{id:'nova',name:'Nova',x:330,y:700}
];
function galaxyDistance(start,system,slot=1){return sharedDistance({system:'origin',...start},{system:system.id||'destination',...system,slot},start);}
function galaxyFlight(s,from,target,start,ship='longProbe'){
 const destination={...target,system:target.system||target.id||'galaxy',slot:target.slot||1};
 const f=sharedFlight(s,from,destination,1,ship,start);
 return {...f,fuel:f.fuel*(ship==='longProbe'?2:1)};
}
function validateGalaxy(data){
 if(!data||!Array.isArray(data.systems)||data.systems.length!==10||!Array.isArray(data.planets)||!Array.isArray(data.missions)||!data.start)throw Error('Ungültige Galaxie-Antwort.');
 const finite=n=>typeof n==='number'&&Number.isFinite(n),ids=new Set();
 for(const sys of data.systems){if(!GALAXY_SYSTEMS.some(s=>s.id===sys.id)||ids.has(sys.id)||!finite(sys.x)||!finite(sys.y)||!Number.isInteger(sys.planetCount)||sys.planetCount<3||sys.planetCount>10)throw Error('Ungültige Systemdaten.');ids.add(sys.id);}
 if(!finite(data.start.x)||!finite(data.start.y)||data.planets.length>100||data.missions.length>100)throw Error('Ungültige Galaxiedaten.');
 for(const p of data.planets){if(!ids.has(p.system)||!/^g-[a-z]+-p(?:[1-9]|10)$/.test(p.id)||!Number.isInteger(p.slot)||p.slot<1||p.slot>10||typeof p.surveyed!=='boolean')throw Error('Ungültige Planetendaten.');if(!p.surveyed&&Object.keys(p).some(k=>!['id','system','slot','surveyed','owner','reserved','commander'].includes(k)))throw Error('Nicht freigegebene Untersuchungsdaten.');if((p.owner!==undefined&&(!['mine','foreign','free'].includes(p.owner)||typeof p.reserved!=='boolean'||!(p.commander===null||typeof p.commander==='string'&&p.commander.length<=30)))||(p.owner===undefined&&(p.reserved!==undefined||p.commander!==undefined)))throw Error('Ungültige Besitzerdaten.');if(p.surveyed&&(typeof p.name!=='string'||p.name.length>40||!Array.isArray(p.mult)||p.mult.length!==3||p.mult.some(n=>!finite(n)||n<0||n>10)||!['home','ferrum','nereus','thalassa'].includes(p.image)||!['mine','foreign','free'].includes(p.owner)||typeof p.reserved!=='boolean'||!finite(p.energy)||p.energy<=0))throw Error('Ungültige Untersuchungsdaten.');}
 if(!finite(data.serverNow)||data.missions.some(m=>!['scan','colony'].includes(m.kind)||typeof m.id!=='string'||typeof m.to!=='string'||!ids.has(m.system)||!finite(m.due)||!finite(m.arrival)||!finite(m.start)||m.start>m.arrival||m.arrival>m.due))throw Error('Ungültige Galaxieflüge.');
