// REALM-CANDIDATE[combatResearch]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function combatStats(key,tech={}){
 const c=COMBAT[key];if(!c)throw Error('Unbekannte Kampfeinheit.');
 return {...c,hp:c.hp*(1+.08*(tech.armor||0)),shield:c.shield*(1+.08*(tech.shields||0)),attack:c.attack*(1+.08*(tech.weapons||0))};
}
function attackFleet(fleet){
 if(!fleet||typeof fleet!=='object'||Array.isArray(fleet))throw Error('Ungültige Angriffsflotte.');
 const entries=Object.entries(fleet);if(!entries.length||entries.some(([k,n])=>!['military','freighter'].includes(SHIPS[k]?.category)||!Number.isSafeInteger(n)||n<1)||!entries.some(([k])=>SHIPS[k].category==='military'))throw Error('Wähle mindestens ein Kriegsschiff und verfügbare Schiffe in ganzen Zahlen.');
 return {...fleet};
}
function attackFlight(s,from,to,fleet){
 attackFleet(fleet);if(!to.system)throw Error('Angriffsziele müssen fremde gemeinsame Kolonien sein.');
 const origin=from.system?from:{...s.galaxy,slot:0};
 if(![origin.x,origin.y,origin.slot,to.x,to.y,to.slot].every(Number.isFinite))throw Error('Der persönliche Galaxie-Startplatz fehlt. Bitte die Galaxie aktualisieren.');
 if(!from.system&&(s.tech.ramjet||0)<1)throw Error('Für Angriffe aus dem Heimatsystem fehlen Staustrahltriebwerke Stufe 1.');
 const dist=sharedDistance(from,to,s.galaxy);
 let ms=0,fuel=0,slowest='';
 for(const [key,count] of Object.entries(fleet)){
  const remote=from.system!==to.system;
  const engine=shipFlightEngine(s,key,remote);
  if(remote&&!canFlyInterstellar(s,key))throw Error(key==='falke'?'Für interstellare Flüge fehlt ein geeigneter Antrieb: Falke-Galaxieantrieb 1 und Staustrahltriebwerke 1 erforderlich.':'Für interstellare Flüge fehlt ein geeigneter Antrieb.');
  if(remote&&(s.tech[engine]||0)<1)throw Error('Für interstellare Flüge fehlt die passende Triebwerksforschung.');
  const f=sharedFlight(s,from,to,count,key);
  if(f.ms>ms){ms=f.ms;slowest=key;}fuel+=f.fuel*2;
 }
 return {distance:dist,ms,fuel,slowest};
}
// REALM-CANDIDATE[sensorWarning]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function warningFraction(sensorLevel){return Math.pow(.9,Math.max(0,sensorLevel)+1);}
function takeHulls(p,fleet){const out={};p.hulls??={};for(const [k,n] of Object.entries(fleet)){const damaged=p.hulls[k]||[];out[k]=damaged.splice(0,n);if(!damaged.length)delete p.hulls[k];}return out;}
function putHulls(p,hulls={}){p.hulls??={};for(const [k,hp] of Object.entries(hulls))if(hp.length)p.hulls[k]=[...(p.hulls[k]||[]),...hp];}
function rng(seed){let n=2166136261;for(const c of seed)n=Math.imul(n^c.charCodeAt(0),16777619)>>>0;return ()=>{n^=n<<13;n^=n>>>17;n^=n<<5;return (n>>>0)/4294967296;};}
function units(fleet,tech,hulls,shieldFactor=1){
 const out=[];for(const key of Object.keys(fleet).sort()){const n=fleet[key];if(!Number.isSafeInteger(n)||n<0)throw Error('Ungültiger Flottenbestand.');const z=combatStats(key,tech);z.shield*=shieldFactor;for(let i=0;i<n;i++)out.push({key,...z,maxHp:z.hp,hp:z.hp*(hulls?.[key]?.[i]??1)});}return out;
}
function combatSide(side){if(!side.groups)return units(side.fleet,side.tech,side.hulls,side.shieldFactor);return side.groups.flatMap(g=>units(g.fleet,g.tech,g.hulls,g.shieldFactor).map(u=>({...u,groupId:g.id,owner:g.owner,commander:g.commander,maxShield:combatStats(u.key,g.tech).shield})));}
function combatGroups(side,list){return side.groups?{defenderGroups:side.groups.map(g=>({id:g.id,owner:g.owner,...survivors(list.filter(u=>u.groupId===g.id)),...(g.id?.startsWith('repair:')?{repairUnits:list.filter(u=>u.groupId===g.id).map(u=>({hp:Math.max(0,u.hp),maxHp:u.maxHp}))}:{})}))}:{};}
function survivors(list){const fleet={},hulls={};for(const u of list)if(u.hp>1e-8){fleet[u.key]=(fleet[u.key]||0)+1;if(u.hp<u.maxHp-1e-8)(hulls[u.key]??=[]).push(u.hp/u.maxHp);}return {fleet,hulls};}
// REALM-CANDIDATE[legacyCombat]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function resolveBattleLegacy(attacker,defender,seed){
 const a=combatSide(attacker),d=combatSide(defender),random=rng(seed),rounds=[];
 for(let i=1;i<=6;i++){
  const aa=a.filter(u=>u.hp>1e-8),dd=d.filter(u=>u.hp>1e-8);if(!aa.length||!dd.length)break;
  const damage=new Map();
  function fire(shooters,targets){for(const u of shooters)if(u.attack)for(let shot=0;shot<u.shots;shot++){const target=targets[Math.floor(random()*targets.length)],hit=u.attack/u.shots*(1+(u.bonus?.[target.key]||0));damage.set(target,(damage.get(target)||0)+hit);}}
  fire(aa,dd);fire(dd,aa);
  for(const [u,hit] of damage){const shield=Math.min(u.shield,hit);u.shield-=shield;u.hp-=hit-shield;}
  rounds.push({round:i,attacker:a.filter(u=>u.hp>1e-8).length,defender:d.filter(u=>u.hp>1e-8).length});
 }
 const aa=survivors(a),dd=survivors(d),ac=Object.values(aa.fleet).reduce((a,b)=>a+b,0),dc=Object.values(dd.fleet).reduce((a,b)=>a+b,0);
 const debris=vector([0,0,0]),defenseRepair=vector([0,0,0]);
 for(const u of [...a,...d])if(u.hp<=1e-8){const sh=SHIPS[u.key],out=debris,rate=.3;out.metal+=sh.cost[0]*rate;out.crystal+=sh.cost[1]*rate;}
 for(const k of RES){debris[k]=Math.floor(debris[k]);defenseRepair[k]=Math.floor(defenseRepair[k]);}
 return {outcome:ac&&!dc?'attacker':dc&&!ac?'defender':'draw',attacker:aa,defender:dd,debris,defenseRepair,rounds,...combatGroups(defender,d)};
}

const COMBAT_RULE_VERSION=3;
function resolveBattle(attacker,defender,seed,version=COMBAT_RULE_VERSION){
 if(version===1)return resolveBattleLegacy(attacker,defender,seed);
 if(version!==2&&version!==3)throw Error('Unbekannte Kampfregelversion.');
 const a=combatSide(attacker),d=combatSide(defender),random=rng(String(seed)),rounds=[],logs=[];
 for(const [side,list] of [['A',a],['D',d]]){const counts={};for(const u of list){counts[u.key]=(counts[u.key]||0)+1;u.id=side+'-'+u.key+'-'+String(counts[u.key]).padStart(3,'0');}}
 const snapshot=u=>({...(u.owner?{owner:u.owner,groupId:u.groupId,commander:u.commander}:{}),id:u.id,key:u.key,side:u.id[0]==='A'?'attacker':'defender',category:SHIPS[u.key].category,name:SHIPS[u.key].name,definition:{...COMBAT[u.key],cost:[...SHIPS[u.key].cost]},hp:Math.max(0,u.hp),maxHp:u.maxHp,shield:u.shield,maxShield:u.maxShield??combatStats(u.key,u.id[0]==='A'?attacker.tech:defender.tech).shield,attack:u.attack,shots:u.shots,bonus:{...u.bonus}});
 const initial=[...a,...d].map(snapshot);
 const total=list=>({count:list.filter(u=>u.hp>1e-8).length,hp:list.reduce((n,u)=>n+Math.max(0,u.hp),0),shield:list.filter(u=>u.hp>1e-8).reduce((n,u)=>n+u.shield,0)});
 for(let round=version===3?0:1;round<=6;round++){
  const aa=a.filter(u=>u.hp>1e-8),dd=d.filter(u=>u.hp>1e-8);if(!aa.length||!dd.length)break;
  const opening=version===3&&round===0,platforms=opening?dd.filter(u=>SHIPS[u.key].category==='defense'):[];
  if(opening&&!platforms.length)continue;
  const damage=new Map(),shots=[];
  function fire(shooters,targets){
   const military=targets.filter(t=>SHIPS[t.key].category==='military');
   const allowed=military.length?targets.filter(t=>['military','defense'].includes(SHIPS[t.key].category)):targets;
   const defense=allowed.filter(t=>SHIPS[t.key].category==='defense'),pools=new Map();
   for(const u of shooters)if(u.attack){
    if(!pools.has(u.key)){const bonusTargets=allowed.filter(t=>(u.bonus?.[t.key]||0)>0);pools.set(u.key,{pool:bonusTargets.length?bonusTargets:military.length?military:defense.length?defense:allowed,reason:bonusTargets.length?'bonus':military.length?'military':defense.length?'defense':'civil'});}
    const {pool,reason}=pools.get(u.key);
    for(let shot=1;shot<=u.shots;shot++){
     const target=pool[Math.floor(random()*pool.length)],base=u.attack/u.shots,bonus=u.bonus?.[target.key]||0,hit=base*(1+bonus);
     shots.push({shooter:u.id,target:target.id,shot,base,bonus,damage:hit,reason});damage.set(target,(damage.get(target)||0)+hit);
    }
   }
  }
  if(!opening)fire(aa,dd);
  fire(opening?platforms:dd,aa);
  const impacts=[];
  for(const [u,hit] of damage){
   const hpBefore=u.hp,shieldBefore=u.shield,shieldDamage=Math.min(u.shield,hit),hullDamage=Math.min(Math.max(0,u.hp),hit-shieldDamage);
   u.shield-=shieldDamage;u.hp-=hit-shieldDamage;
   impacts.push({target:u.id,damage:hit,shieldDamage,hullDamage,overkill:Math.max(0,hit-shieldDamage-hpBefore),hpBefore,shieldBefore,hpAfter:Math.max(0,u.hp),shieldAfter:u.hp>1e-8?u.shield:0,destroyed:u.hp<=1e-8});
  }
  const after={attacker:total(a),defender:total(d)};
  rounds.push({round,attacker:after.attacker.count,defender:after.defender.count});
  logs.push({round,shots,impacts,after});
 }
 const aa=survivors(a),dd=survivors(d),ac=Object.values(aa.fleet).reduce((n,v)=>n+v,0),dc=Object.values(dd.fleet).reduce((n,v)=>n+v,0),outcome=ac&&!dc?'attacker':dc&&!ac?'defender':'draw';
 const debris=vector([0,0,0]),defenseRepair=vector([0,0,0]);
 for(const u of [...a,...d])if(u.hp<=1e-8){const sh=SHIPS[u.key],out=debris,rate=.3;out.metal+=sh.cost[0]*rate;out.crystal+=sh.cost[1]*rate;}
 for(const k of RES){debris[k]=Math.floor(debris[k]);defenseRepair[k]=Math.floor(defenseRepair[k]);}
 return {outcome,attacker:aa,defender:dd,debris,defenseRepair,rounds,...combatGroups(defender,d),trace:{...(defender.groups?{defenderGroups:structuredClone(defender.groups)}:{}),version:1,ruleVersion:version,seed:String(seed),tech:{attacker:{...attacker.tech},defender:{...defender.tech}},shieldFactors:{attacker:attacker.shieldFactor??1,defender:defender.shieldFactor??1},initial,final:[...a,...d].map(snapshot),rounds:logs}};
}

function loadPlunder(stock,depot,bunker,capacity,debris,victory){
 const loot=vector([0,0,0]),salvage=vector([0,0,0]);let room=Math.max(0,capacity);
 if(victory)for(const k of RES){loot[k]=Math.min(room,Math.floor(Math.max(0,stock[k]+depot[k]-bunker)*.25));room-=loot[k];}
 if(victory)for(const k of RES){salvage[k]=Math.min(room,debris[k]);room-=salvage[k];}
 return {loot,salvage,cargo:vector(RES.map(k=>loot[k]+salvage[k]))};
}


// REALM-CANDIDATE[repairRates]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
const REPAIR_RATE=.3;
const ORBITAL_RESTORE_RATE=.7;
function repairAvailable(p,key){return (p.disabledDefenses?.[key]||0)+(p.hulls?.[key]||[]).length;}
function recordDisabledDefenses(p,before,after){p.disabledDefenses??={};for(const [key,sh] of Object.entries(SHIPS))if(sh.category==='defense'){const lost=Math.max(0,(before[key]||0)-(after[key]||0));if(lost)p.disabledDefenses[key]=(p.disabledDefenses[key]||0)+lost;}}

// REALM-CANDIDATE[repairQueue]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
const REPAIR_QUEUE_LIMIT=20;
function repairOrders(p){return p.repairQueue||[];}
function repairCount(p,key){return repairOrders(p).filter(j=>j.key===key).reduce((n,j)=>n+j.entries.length,0);}
function orbitCondition(p,key){
 const free=Number(p.ships?.[key]||0),hulls=p.hulls?.[key]||[],docked=repairOrders(p).filter(j=>j.key===key).flatMap(j=>j.entries.map(e=>e.hp));
 const disabled=p.disabledDefenses?.[key]||0;
 const total=free+docked.length+disabled,damaged=hulls.length+docked.length+disabled,missing=[...hulls,...docked].reduce((n,h)=>n+1-h,disabled);
 return {total,disabled,free,docked:docked.length,damaged,intact:total-damaged,hull:total?1-missing/total:1,damagedHull:damaged?1-missing/damaged:1};
}
// REALM-CANDIDATE[repairTime]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function repairQuote(p,key,count=1,ratio=1){
 if(!SHIPS[key])throw Error('Unbekannte Einheit.');
 const hulls=[...p.hulls?.[key]||[]].sort((a,b)=>a-b),disabled=p.disabledDefenses?.[key]||0;
 if(!Number.isSafeInteger(count)||count<1||count>repairAvailable(p,key)||count>100000)throw Error('Wähle eine gültige Anzahl beschädigter Einheiten.');
 const restore=disabled>0;if(restore&&count>(p.disabledDefenses?.[key]||0))throw Error('Defekte und teilbeschädigte Geschütze bitte getrennt reparieren.');
 const selected=restore?Array(count).fill(0):hulls.slice(0,count),damage=selected.reduce((n,h)=>n+1-h,0),factor=restore?Math.pow(.92,Math.max(0,(p.buildings.orbital||0)-1)+(p.buildings.robotics||0)):Math.pow(.92,Math.max(0,(p.buildings.repairDock||0)-1));
 const work=Math.max(1,SHIPS[key].time*1000*(restore?1:REPAIR_RATE)*damage*factor);
 return {restore,hulls:selected,count,cost:vector(SHIPS[key].cost.map((c,i)=>i===2?0:Math.ceil(c*(restore?ORBITAL_RESTORE_RATE:REPAIR_RATE)*damage))),work,factor,ms:ratio>0?Math.ceil(work/ratio):null,hull:1-damage/count};
}
function repairMaterials(j){if(j.restore)return vector([0,0,0]);return vector(RES.map((k,i)=>i===2?0:Math.max(0,Math.ceil(j.entries.reduce((n,e)=>n+Math.max(0,SHIPS[j.key].cost[i]*REPAIR_RATE*(1-e.hp)-e.credit[k]),0)-1e-7))));}
function repairRefund(j){return vector(RES.map(k=>Math.floor(j.entries.reduce((n,e)=>n+e.credit[k],0)+1e-7)));}
function reserveRepair(p,key,quote,id,time){
 if(quote.restore){p.disabledDefenses[key]-=quote.count;}
 const remaining=[...p.hulls?.[key]||[]].sort((a,b)=>a-b).slice(quote.restore?0:quote.count);p.hulls??={};if(remaining.length)p.hulls[key]=remaining;else delete p.hulls[key];
 if(!quote.restore)p.ships[key]-=quote.count;
 const entries=quote.hulls.map(hp=>({hp,initialHp:hp,workRemaining:Math.max(1,SHIPS[key].time*1000*(quote.restore?1:REPAIR_RATE)*(1-hp)*quote.factor),credit:vector(SHIPS[key].cost.map((c,i)=>i===2?0:c*(quote.restore?ORBITAL_RESTORE_RATE:REPAIR_RATE)*(1-hp)))}));
 for(const k of RES)entries[0].credit[k]+=quote.cost[k]-entries.reduce((n,e)=>n+e.credit[k],0);
 const job={...(quote.restore?{restore:true}:{}),id,key,start:time,count:quote.count,completed:0,lost:0,factor:quote.factor,entries};(p.repairQueue??=[]).push(job);return job;
}
function payRepairMaterials(j,cost){for(const [i,k] of RES.entries()){if(i===2)continue;let left=cost[k];for(const e of j.entries){const need=Math.max(0,SHIPS[j.key].cost[i]*REPAIR_RATE*(1-e.hp)-e.credit[k]),amount=Math.min(need,left);e.credit[k]+=amount;left-=amount;}if(left>0&&j.entries.length)j.entries[0].credit[k]+=left;}}
function releaseRepair(p,j){p.hulls??={};for(const e of j.entries){if(j.restore){p.disabledDefenses??={};p.disabledDefenses[j.key]=(p.disabledDefenses[j.key]||0)+1;continue;}p.ships[j.key]++;if(e.hp<1)(p.hulls[j.key]??=[]).push(e.hp);}p.repairQueue=repairOrders(p).filter(q=>q.id!==j.id);}
function forecastRepair(p,time,ratio){
 let wait=0,blocked=false;
 for(const j of repairOrders(p)){j.materials=repairMaterials(j);blocked||=RES.some(k=>j.materials[k]>0);j.paused=blocked||ratio===0;wait+=j.entries.reduce((n,e)=>n+e.workRemaining,0);j.end=time+Math.max(1,Math.ceil(wait/(ratio||1)));}
 const active=repairOrders(p)[0];return active&&!active.paused?time+Math.max(0,Math.ceil(active.entries[0].workRemaining/ratio)):Infinity;
}
function produceRepair(p,elapsed,ratio){
 const j=repairOrders(p)[0];if(!j||j.paused||!j.entries.length)return;
 const e=j.entries[0],work=Math.min(e.workRemaining,elapsed*ratio),fraction=e.workRemaining?work/e.workRemaining:1;
 e.hp=Math.min(1,e.hp+(1-e.hp)*fraction);for(const k of RES)e.credit[k]*=1-fraction;
 e.workRemaining=Math.max(0,e.workRemaining-work);if(e.workRemaining<1e-6){e.workRemaining=0;e.hp=1;}
}
function finishRepair(p,notify){const j=repairOrders(p)[0];if(!j||j.entries[0]?.workRemaining>1e-6)return 0;let finished=0;while(j.entries[0]?.workRemaining<=1e-6){j.entries.shift();j.completed++;finished++;p.ships[j.key]++;}if(!j.entries.length){p.repairQueue.shift();notify?.('Reparatur abgeschlossen',`${p.name}: ${j.completed} × ${SHIPS[j.key].name} wieder einsatzbereit.`);}return finished;}
// Docked units remain separate battle groups so losses preserve paid material and identity.
function repairDefense(p,owner,commander,tech,shieldFactor){return repairOrders(p).filter(j=>!j.restore).map(j=>({id:'repair:'+j.id,owner,commander:commander+' · Reparaturdock',fleet:{[j.key]:j.entries.length},hulls:{[j.key]:j.entries.map(e=>e.hp)},tech,shieldFactor}));}
function reconcileRepairBattle(p,result){
 for(const j of [...repairOrders(p)].filter(j=>!j.restore)){
  const finals=result.trace?.final?.filter(u=>u.groupId==='repair:'+j.id)||result.defenderGroups?.find(g=>g.id==='repair:'+j.id)?.repairUnits||[];
  if(finals.length!==j.entries.length)throw Error('Reparaturdock: Kampfzuordnung fehlt.');
  j.entries=j.entries.flatMap((e,i)=>{const u=finals[i];if(u.hp<=1e-8){if(SHIPS[j.key].category==='defense'){p.disabledDefenses??={};p.disabledDefenses[j.key]=(p.disabledDefenses[j.key]||0)+1;}j.lost++;return [];}e.hp=Math.min(1,u.hp/u.maxHp);e.initialHp=e.hp;e.workRemaining=Math.max(1,SHIPS[j.key].time*1000*REPAIR_RATE*(1-e.hp)*j.factor);return [e];});
  if(!j.entries.length)p.repairQueue=p.repairQueue.filter(q=>q.id!==j.id);
 }
}






function planet(id,name,meta={}){
 return {id,name,coord:meta.coord||'1:1:4',kind:meta.kind||'Heimatwelt',mult:meta.mult||[1,1,1],color:meta.color||'#53add3',ocean:meta.ocean??true,energy:meta.energy||1,distance:meta.distance||0,reserves:vector([0,0,0]),resources:vector([0,0,0]),depot:vector([0,0,0]),buildings:Object.fromEntries(Object.keys(BUILDINGS).map(k=>[k,0])),ships:Object.fromEntries(Object.keys(SHIPS).map(k=>[k,0])),build:null,shipjob:null,orbitaljob:null,orbitalqueue:[]};
}
// REALM-CANDIDATE[newGame]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function newGame(name='Commander',now=Date.now()){
 const home=planet('home','Aurelia');
 home.resources=vector([3000,2200,1000]); Object.assign(home.buildings,{metal:1,crystal:1,fuel:1,solar:3});
 return {version:1,name:name.trim().slice(0,30)||'Commander',time:now,created:now,seq:0,active:'home',planets:[home],tech:Object.fromEntries(Object.keys(TECHS).map(k=>[k,0])),research:null,discovered:[],missions:[],reports:[]};
}
function getPlanet(s,id){const p=s.planets.find(p=>p.id===id);if(!p)throw Error('Planet nicht gefunden.');return p;}
// REALM-CANDIDATE[warehouse]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function capacity(p){return 4000*Math.pow(1.7,p.buildings.warehouse);}
// REALM-CANDIDATE[yardTime]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function shipyardTimeFactor(level){return Math.pow(.92,Math.max(0,level-1));}
// REALM-CANDIDATE[energyDemand]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function energyDemand(p){
 const consumers={metal:p.buildings.metal*15,crystal:p.buildings.crystal*18,fuel:p.buildings.fuel*20,shipyard:Math.ceil(10*Math.pow(p.buildings.shipyard,1.5)),orbital:Math.ceil(10*Math.pow((p.buildings.orbital||0),1.5)),repairDock:Math.ceil(10*Math.pow((p.buildings.repairDock||0),1.5))};
 return Object.fromEntries(Object.entries(consumers).map(([key,value])=>[key,value*p.energy]));
}
// REALM-CANDIDATE[production]: siehe auskommentierten Katalog in src/realm-config.js; noch nicht verdrahtet.
function dailyQuestMultiplier(bonus,planetId,resource,time){return bonus&&bonus.planetId===planetId&&time>=bonus.startedAt&&time<bonus.expiresAt&&(bonus.reward==='all'||bonus.reward===resource)?(bonus.reward==='all'?1.05:1.09):1;}
function stats(s,p){
 const supply=([['solar',45],['tidal',180],['fuelPower',180]].reduce((total,[key,base])=>{const cfg=powerPlantConfig(p.kind,key),level=p.buildings[key]||0;return total+(level>0?base*Math.pow(level,cfg.exponent)*cfg.efficiency:0);},0))*(1+s.tech.energy*.1);
 const consumers=energyDemand(p),demand=Object.values(consumers).reduce((a,b)=>a+b,0);
 const ratio=demand?Math.min(1,supply/demand):1;
 const rates=vector(RES.map((k,i)=>p.buildings[k]?([300,220,140][i]*p.buildings[k]*Math.pow(1.12,p.buildings[k]-1)*p.mult[i]*ratio*dailyQuestMultiplier(s.dailyPirateBonus,p.id,k,s.time)):0));
 return {supply,demand,consumers,ratio,rates,cap:capacity(p)};
}
function settle(p){const cap=capacity(p);for(const k of RES){const n=Math.min(Math.max(0,cap-p.resources[k]),p.depot[k]);p.resources[k]+=n;p.depot[k]-=n;}}
function deliver(p,cargo){for(const k of RES)p.depot[k]+=cargo[k];settle(p);}
// A ship can unload only into actual warehouse space. Remaining cargo stays aboard.
function unloadCargo(p,cargo,order=null){settle(p);const cap=capacity(p),out=vector([0,0,0]);for(const k of RES){const wanted=!order||order[k]==='max'?cargo[k]:Math.min(cargo[k],order[k]);out[k]=Math.min(wanted,Math.floor(Math.max(0,cap-p.resources[k])));p.resources[k]+=out[k];cargo[k]-=out[k];}return out;}
function cargoPresent(cargo){return RES.some(k=>cargo[k]>0);}
// Shared cargo can become unloadable when a warehouse completes or a local route loads.
function nextCargoSpaceEvent(s,p){return Math.min(p.build?.key==='warehouse'?p.build.end:Infinity,...s.missions.filter(m=>!m.paused&&!m.awaitingUnload).map(m=>m.due));}
function waitingCargo(s){for(const m of [...s.missions])if(m.paused&&m.type==='route'){const out=unloadCargo(getPlanet(s,m.home),m.cargo);if(cargoPresent(out))routeActivity(s,m,m.home,out,vector([0,0,0]),'unload');}else if(m.awaitingUnload){const p=getPlanet(s,m.awaitingUnload),out=unloadCargo(p,m.cargo);if(m.type==='route'&&cargoPresent(out))routeActivity(s,m,p.id,out,vector([0,0,0]),'unload');m.due=s.time;if(!cargoPresent(m.cargo))parkFleet(s,m,p.id,m.finishTitle||'Flotte entladen');}}
// Work is measured in milliseconds at full power; forecasts never replace earned progress.
function forecastShipJobs(s,readStats=p=>stats(s,p)){for(const p of s.planets)for(const kind of ['ship','orbital']){const j=p[kind+'job'];if(!j)continue;
 if(j.workRemaining===undefined){j.orderEnd=j.end;j.workTotal=j.end-j.start;j.workRemaining=Math.max(0,j.end-s.time);}
