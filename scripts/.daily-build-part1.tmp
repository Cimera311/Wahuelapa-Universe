}
function fleetLegInfo(s,from,to,fleet){let ms=0,fuel=0,slowest='';for(const [k,n] of Object.entries(missionFleet(fleet,true))){if((from.system||'tutorial')!==(to.system||'tutorial')&&!canFlyInterstellar(s,k))throw Error('Für '+SHIPS[k].name+' fehlt der Galaxieantrieb.');const f=legInfo(s,from,to,n,k);if(f.ms>ms){ms=f.ms;slowest=k;}fuel+=f.fuel;}return {ms,fuel,slowest,capacity:fleetCapacity(s,fleet)};}
function fleetCapacity(s,fleet){return Object.entries(fleet).reduce((a,[k,n])=>a+cargoCapacity(s,n,k),0);}
